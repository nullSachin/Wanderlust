<% layout("/layouts/boilerplate") %>

<div id="filters">
    <div class="filter"><div><i class="fa-solid fa-fire"></i></div><p>Trending</p></div>
    <div class="filter"><div><i class="fa-solid fa-bed"></i></div><p>Rooms</p></div>
    <div class="filter"><div><i class="fa-solid fa-mountain-city"></i></div><p>Iconic cities</p></div>
    <div class="filter"><div><i class="fa-solid fa-mountain"></i></div><p>Mountains</p></div>
    <div class="filter"><div><i class="fa-brands fa-fort-awesome"></i></div><p>Castles</p></div>
    <div class="filter"><div><i class="fa-solid fa-person-swimming"></i></div><p>Amazing Pools</p></div>
    <div class="filter"><div><i class="fa-solid fa-campground"></i></div><p>Camping</p></div>
    <div class="filter"><div><i class="fa-solid fa-cow"></i></div><p>Farms</p></div>
    <div class="filter"><div><i class="fa-regular fa-snowflake"></i></div><p>Arctic</p></div>
    <div class="filter"><div><i class="fa-solid fa-igloo"></i></div><p>Domes</p></div>
    <div class="filter"><div><i class="fa-solid fa-ship"></i></div><p>Boats</p></div>
</div>

<% if (destinations.length) { %>
<section class="wl-section">
    <div class="wl-section-head">
        <h2>Destinations for you</h2>
        <div class="wl-arrows">
            <button type="button" class="wl-arrow" data-dir="-1" aria-label="Scroll left"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" class="wl-arrow" data-dir="1" aria-label="Scroll right"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
    <div class="wl-row">
        <% for (let d of destinations) { %>
            <a href="/listings" class="wl-dest">
                <img src="<%= d.image.url %>" alt="<%= d.location %>" loading="lazy">
                <div class="wl-dest-name"><%= d.location %></div>
                <div class="wl-dest-sub"><%= d.country %></div>
            </a>
        <% } %>
    </div>
</section>
<% } %>

<% for (let section of popularSections) { %>
<section class="wl-section">
    <div class="wl-section-head">
        <h2>Popular homes in <%= section.country %></h2>
        <div class="wl-arrows">
            <button type="button" class="wl-arrow" data-dir="-1" aria-label="Scroll left"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" class="wl-arrow" data-dir="1" aria-label="Scroll right"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
    <div class="wl-row">
        <% for (let listing of section.listings) { %>
            <%- include("../includes/listing-card", { listing: listing, favouriteIds: favouriteIds }) %>
        <% } %>
    </div>
</section>
<% } %>

<section class="wl-section">
    <div class="wl-section-head">
        <h2>All stays</h2>
    </div>
    <div class="wl-grid">
        <% for (let listing of allListings) { %>
            <%- include("../includes/listing-card", { listing: listing, favouriteIds: favouriteIds }) %>
        <% } %>
    </div>
</section>

<div id="page-data" data-logged-in="<%= currUser ? 'true' : 'false' %>" hidden></div>

<script>
    const isLoggedIn = document.getElementById("page-data").dataset.loggedIn === "true";

    // Scroll arrows for every sideways row
    document.querySelectorAll(".wl-section").forEach(function (section) {
        const row = section.querySelector(".wl-row");
        const prev = section.querySelector('[data-dir="-1"]');
        const next = section.querySelector('[data-dir="1"]');
        if (!row || !prev || !next) return;

        function update() {
            prev.disabled = row.scrollLeft <= 4;
            next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
        }
        prev.addEventListener("click", function () {
            row.scrollBy({ left: -row.clientWidth * 0.9, behavior: "smooth" });
        });
        next.addEventListener("click", function () {
            row.scrollBy({ left: row.clientWidth * 0.9, behavior: "smooth" });
        });
        row.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
    });

    // Favourite hearts
    document.addEventListener("click", async function (e) {
        const btn = e.target.closest(".fav-btn");
        if (!btn) return;
        e.preventDefault();

        if (!isLoggedIn) {
            window.location.href = "/login";
            return;
        }
        try {
            const res = await fetch("/listings/" + btn.dataset.id + "/favourite", {
                method: "POST",
                headers: { "Accept": "application/json" },
            });
            if (!res.ok) throw new Error("Request failed");
            const data = await res.json();
            document.querySelectorAll('.fav-btn[data-id="' + btn.dataset.id + '"]').forEach(function (b) {
                b.classList.toggle("active", data.favourited);
                b.setAttribute("aria-pressed", data.favourited);
            });
        } catch (err) {
            console.error(err);
        }
    });
</script>