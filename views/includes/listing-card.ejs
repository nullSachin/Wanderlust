<% const isFav = favouriteIds.includes(listing._id.toString()); %>
<div class="wl-card">
  <a href="/listings/<%= listing._id %>" class="wl-card-link">
    <div class="wl-card-img">
      <img src="<%= listing.image.url %>" alt="<%= listing.title %>" loading="lazy">
    </div>
    <div class="wl-card-body">
      <div class="wl-card-title"><%= listing.title %></div>
      <div class="wl-card-sub"><%= listing.location %>, <%= listing.country %></div>
      <div class="wl-card-price">&#8377; <%= listing.price.toLocaleString("en-IN") %> / night</div>
    </div>
  </a>
  <button type="button" class="fav-btn <%= isFav ? 'active' : '' %>" data-id="<%= listing._id %>"
          aria-label="Save to favourites" aria-pressed="<%= isFav %>">
    <i class="fa-solid fa-heart"></i>
  </button>
</div>