<% layout("/layouts/boilerplate") %>

<div class="auth-wrapper">
  <div class="auth-card">
    <h2 class="auth-title">Log in</h2>
    <p class="auth-subtitle">Welcome back to WanderLust</p>

    <a href="/auth/google" class="social-btn">
      <i class="fa-brands fa-google"></i> Continue with Google
    </a>
    <a href="/auth/facebook" class="social-btn">
      <i class="fa-brands fa-facebook" style="color:#1877F2;"></i> Continue with Facebook
    </a>

    <div class="auth-divider"><span>or</span></div>

    <form action="/login" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="username" class="auth-label">Username</label>
        <input type="text" id="username" name="username" class="auth-input" required>
      </div>
      <div class="mb-3">
        <label for="password" class="auth-label">Password</label>
        <input type="password" id="password" name="password" class="auth-input" required>
      </div>
      <button type="submit" class="auth-submit">Log in</button>
    </form>

    <p class="auth-footer-text">Don't have an account? <a href="/signup">Sign up</a></p>
  </div>
</div>